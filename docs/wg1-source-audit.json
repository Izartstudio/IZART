  "schema": [
    "\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"CreativeWork\",\n  \"name\": \"WG1\",\n  \"description\": \"WG1 is a nutraceutical brand built around a single principle: health lives in what you repeat, in the ordinary days, in the things you do without thinking. The project distills foundational nutrition into a calm, dependable daily ritual, designed for people whose lives are too inconsistent for complexity but too aware to ignore the basics.\",\n  \"url\": \"/projects/wg1\",\n  \"image\": \"https://cdn.prod.website-files.com/69ba531296507e4235379d9c/6a0995b62b637c42309ca5f5_wg11.avif\",\n  \"creator\": {\n    \"@type\": \"Organization\",\n    \"name\": \"WG1\"\n  },\n  \"datePublished\": \"2026-05-27T09:23:58.411Z\",\n  \"dateModified\": \"2026-05-27T09:18:33.242Z\",\n  \"inLanguage\": \"en\",\n  \"about\": {\n    \"@type\": \"Service\",\n    \"serviceType\": \"\"\n  },\n  \"temporalCoverage\": \"2025\"\n}\n"
