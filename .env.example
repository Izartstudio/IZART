SITE_INDEXABLE=false
SITE_URL=https://www.izart.in
# Leave unset for local sample content. Set both project IDs when connecting Sanity.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Optional server-only read token for a private dataset. Never use a public prefix.
SANITY_API_READ_TOKEN=
# Server-only Google Apps Script web app connection for the enquiry form.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=
# Server-only Google Apps Script connection for career applications.
CAREERS_GOOGLE_SHEETS_WEBHOOK_URL=
CAREERS_GOOGLE_SHEETS_WEBHOOK_SECRET=
# SEO launch: set SITE_INDEXABLE=true only on the production deployment.
# AI search is enabled on indexable production; training is an independent choice.
AI_TRAINING_ALLOWED=false
# Google-Extended controls both Gemini training and grounding. Keep true for grounding.
GOOGLE_EXTENDED_ALLOWED=true
# Carry over existing Search Console / Bing verification if present.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
